  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SupersuitUp/superskill.git"
  },
  "homepage": "https://supersuit.wiki/concepts/superskill",
